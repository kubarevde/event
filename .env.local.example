# Пароль для входа в админку (/admin). Обязателен.
ADMIN_PASSWORD=придумайте-длинный-пароль

# Секрет для подписи сессии админа (любая длинная случайная строка).
# Если не задан, используется ADMIN_PASSWORD.
SESSION_SECRET=

# Папка с базой данных (SQLite) и загруженными картинками.
# По умолчанию ./storage. На сервере её нужно сохранять между деплоями и бэкапить.
DATA_DIR=

# Поставьте 1, только если сайт открывается по http:// без https —
# иначе браузер не сохранит cookie входа в админку.
INSECURE_COOKIES=
