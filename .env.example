# Адрес и порт контейнера на сервере. По умолчанию 127.0.0.1:3001 —
# доступен только локальному nginx, снаружи напрямую не открыть.
APP_BIND=127.0.0.1
APP_PORT=3001

# Пароль для входа в админку (https://домен/admin)
ADMIN_PASSWORD=придумайте-длинный-пароль

# Любая длинная случайная строка (например: openssl rand -hex 32)
SESSION_SECRET=

# Заголовок, в котором WAF передаёт IP посетителя, если это не X-Forwarded-For
# (например CF-Connecting-IP). Обычно оставьте пустым: сайт сам берёт первый публичный
# адрес из X-Forwarded-For. Проверить: админка → «Диагностика».
CLIENT_IP_HEADER=

# 1 — только если сайт открывают по http без https (без WAF)
INSECURE_COOKIES=
