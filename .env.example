# Домен сайта. Должен смотреть A-записью на IP сервера — тогда HTTPS включится сам.
# Если домена пока нет, укажите :80 (сайт будет по http://IP-сервера) и INSECURE_COOKIES=1
DOMAIN=digital.tsu.ru

# Пароль для входа в админку (https://домен/admin)
ADMIN_PASSWORD=придумайте-длинный-пароль

# Любая длинная случайная строка (например: openssl rand -hex 32)
SESSION_SECRET=

# 1 — только если сайт работает по http без https
INSECURE_COOKIES=
