# Порт на сервере, на который WAF проксирует запросы (http)
APP_PORT=80

# Пароль для входа в админку (https://домен/admin)
ADMIN_PASSWORD=придумайте-длинный-пароль

# Любая длинная случайная строка (например: openssl rand -hex 32)
SESSION_SECRET=

# Заголовок, в котором WAF передаёт реальный IP посетителя (например X-Real-IP).
# Пусто — берётся последний адрес из X-Forwarded-For.
CLIENT_IP_HEADER=

# 1 — только если сайт открывают по http без https (без WAF)
INSECURE_COOKIES=
